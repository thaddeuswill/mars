# BACKLOG #49 commit 2: the Keeper's Journal screen (mars:planet_1), 1280x720, GUI scale 3.
wait 100
cmd /gamerule doDaylightCycle false
cmd /gamerule doWeatherCycle false
cmd /weather clear
cmd /time set 6000
cmd /mars go
wait 80
# Test pad (BACKLOG #49): this script builds on its own flat pad (y 63 top, air above), so it does not depend on the dimension generator.
cmd /fill -24 63 -24 24 63 24 minecraft:red_sand
cmd /fill -24 64 -24 24 72 24 minecraft:air
wait 10
cmd /mars gate latch dome_stable
wait 40
shot journal_1_chat_pointer
journal
wait 60
shot journal_2_screen_first_open
