# Habitat restyle wiring (jar 0.3.2-stage3-c): dome from outside (noon, low sun), roof fixtures, hatch door,
# porthole bank, tank, maker and reclaimer. Dome corner (-3, 63, -4); floor y 63, walls y 64..66, roof y 67.
wait 100
cmd /gamerule doDaylightCycle false
cmd /gamerule doWeatherCycle false
cmd /weather clear
cmd /time set 6000
cmd /mars go
wait 120
view -13 70 -15 315 24
wait 40
shot hab_1_outside_noon_nw
view 30 70 22 135 22
wait 20
shot hab_2_outside_noon_se
view -6 70 -6 315 12
wait 20
shot hab_3_roof_dish_and_vent
view 8.5 66.2 18 180 14
wait 20
shot hab_4_door_south_wall_outside
view 8.5 66 -9 0 4
wait 20
shot hab_5_porthole_bank_outside
view 8.5 65.6 0.5 180 2
wait 20
shot hab_6_porthole_bank_inside
view 15.5 65.6 -0.3 180 14
wait 100
shot hab_7_makers_and_reclaimer
view 17.5 65.6 -0.3 200 14
wait 40
shot hab_7b_reclaimer_and_makers_closer
view 0.5 65.6 -2.4 0 14
wait 20
shot hab_8_shelter_tanks
cmd /time set 12400
view -13 70 -15 315 24
wait 100
shot hab_9_outside_low_sun
view 30 70 22 135 22
wait 40
shot hab_10_outside_low_sun_se
quit
