# Bunk and crate in the starter dome (jar 0.3.7-stage3-h). Dome corner (-3,63,-4): world = template - (3,4).
wait 100
cmd /gamerule doDaylightCycle false
cmd /gamerule doWeatherCycle false
cmd /weather clear
cmd /time set 6000
cmd /mars go
wait 120
view 0.5 65.6 -0.5 90 20
wait 40
shot fur_1_bunk_2m_day
view 2.5 65.6 -0.5 90 20
wait 40
shot fur_2_bunk_4m_day
view 5.5 65.6 1.5 0 20
wait 40
shot fur_3_crate_2m_day
view 5.5 65.6 -0.5 0 20
wait 40
shot fur_4_crate_4m_day
cmd /time set 18000
view 0.5 65.6 -0.5 90 20
wait 60
shot fur_5_bunk_2m_night
view 2.5 65.6 -0.5 90 20
wait 40
shot fur_6_bunk_4m_night
view 5.5 65.6 1.5 0 20
wait 40
shot fur_7_crate_2m_night
view 5.5 65.6 -0.5 0 20
wait 40
shot fur_8_crate_4m_night
quit
