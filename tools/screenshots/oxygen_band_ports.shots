# Processor east-face ports after the lighter-alloy fix, plus oxygen maker east end and back. Real generated pad.
wait 100
cmd /gamerule doDaylightCycle false
cmd /gamerule doWeatherCycle false
cmd /weather clear
cmd /time set 6000
cmd /mars go
wait 300
cmd /setblock -8 81 10 mars:atmospheric_processor[facing=north]
cmd /setblock -8 81 14 mars:oxygen_maker[facing=north]
wait 60
view -4.5 82.0 10.5 90 22
wait 60
shot band_processor_east_ports_v2
wait 20
view -4.5 82.0 14.5 90 22
wait 60
shot band_oxygen_end_east_v2
wait 20
view -7.5 82.0 18 180 22
wait 60
shot band_oxygen_back_v2
wait 20
quit
