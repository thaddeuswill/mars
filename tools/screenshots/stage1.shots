# Stage 1 screenshot script for the dev-only helper (mars.client.dev.DevTools).
# One step per line: cmd <command> | wait <ticks> | view x y z yaw pitch | hud on|off | fps | shot <name> | quit
wait 100
cmd /gamerule doDaylightCycle false
cmd /gamerule doWeatherCycle false
cmd /weather clear
cmd /time set 6000
cmd /mars go
wait 80
# Test pad (BACKLOG #49): this script builds on its own flat pad (y 63 top, air above), so it does not depend on the dimension generator.
cmd /fill -24 63 -24 24 63 24 minecraft:red_sand
cmd /fill -24 64 -24 24 72 24 minecraft:air
wait 10
cmd /setblock 2 64 4 minecraft:iron_block
cmd /setblock 3 64 4 minecraft:glass
cmd /setblock 4 64 4 minecraft:white_concrete
cmd /setblock 3 65 4 minecraft:sea_lantern
hud on
wait 60
fps
shot stage1_mars_hud
wait 20
view 0.5 66 -4 0 20
wait 80
fps
shot stage1_mars_blocks
wait 20
view -10 75 -10 -45 30
wait 80
shot stage1_mars_overview
wait 20
cmd /mars back
wait 80
hud off
shot stage1_overworld
wait 20
quit
