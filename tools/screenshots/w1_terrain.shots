# W1 terrain on the real Mars level (mars:planet_1), generated by the new MarsChunkGenerator. Seed 20261126 (DevTools).
# Looks at the dome pad, small craters, a large crater, dunes, a mesa. No test pad here: this IS the terrain test.
# Positions come from the pure landform maths and the headless terrain probe (see the W1 report).
wait 100
cmd /gamerule doDaylightCycle false
cmd /gamerule doWeatherCycle false
cmd /weather clear
cmd /time set 6000
cmd /mars go
wait 300
view 0.5 81 0.5 250 2
wait 200
shot w1_01_ground_pad_east
view 0.5 81 0.5 90 2
wait 100
shot w1_02_ground_pad_west
view 56 86 -40 233 -12
wait 200
shot w1_03_small_crater_from_rim
view 0 140 120 180 38
wait 300
shot w1_04_aerial_oblique_pad
view 120 120 -110 225 22
wait 300
shot w1_05_large_crater_approach
view 218 150 -207 180 60
wait 300
shot w1_06_large_crater_above
view 40 96 90 321 12
wait 300
shot w1_07_dunes_ground
view 80 170 230 180 55
wait 300
shot w1_08_dunes_aerial
view -520 110 150 115 5
wait 400
shot w1_09_mesa
wait 20
quit
